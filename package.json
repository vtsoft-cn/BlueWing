{
  "name": "bluewing-connect",
  "productName": "BlueWing Connect",
  "version": "1.0.0",
  "description": "基于 Sing-box 官方原生核心打造的现代化通用代理客户端与网络调试工具",
  "main": "dist/main/index.js",
  "author": {
    "name": "Garden"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.node.json",
    "test": "npx tsx --test src/__tests__/backup.test.ts src/__tests__/core.test.ts src/__tests__/storage.test.ts src/__tests__/routing.test.ts src/__tests__/ui_log.test.ts",
    "dist": "node scripts/preserve-data.js backup && npm run build && electron-builder && node scripts/preserve-data.js restore",
    "dist:dir": "node scripts/preserve-data.js backup && npm run build && electron-builder --dir && node scripts/preserve-data.js restore"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.bluewing.connect",
    "productName": "BlueWing Connect",
    "copyright": "Copyright © 2026 Garden",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "bin/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/images",
        "to": "images",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/images/ico/ico.ico",
      "artifactName": "BlueWingConnect-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "src/images/ico/ico.ico",
      "uninstallerIcon": "src/images/ico/ico.ico",
      "installerHeaderIcon": "src/images/ico/ico.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "青翼连接",
      "artifactName": "BlueWingConnect-Setup.exe"
    }
  }
}